{
  "compilerOptions": {
    "target": "es2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@utils/*": ["src/utils/*"],
      "@/*": ["src/*"]
    },
    "typeRoots": ["node_modules/@types"],
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "incremental": false,
    "noEmitOnError": false,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "**/__tests__/*",
    "src/scenes/**",
    "src/GameEngine/engines/**",
    "src/GameEngine/battle/**",
    "src/GameEngine/core/data/**",
    "src/GameEngine/core/error/**",
    "src/GameEngine/core/config/**",
    "src/GameEngine/core/tools/**",
    "src/GameEngine/core/objects/Panel.ts",
    "src/GameEngine/core/objects/PanelRenderComponent.ts",
    "src/GameEngine/core/objects/UIButton.ts",
    "src/GameEngine/core/objects/DialogPanel.ts",
    "src/GameEngine/core/objects/SpriteComponent.ts",
    "src/GameEngine/core/objects/ColliderComponent.ts",
    "src/GameEngine/core/objects/NodeGraphRenderComponent.ts",
    "src/GameEngine/core/objects/CustomRenderComponent.ts",
    "src/GameEngine/core/objects/AudioComponent.ts",
    "src/GameEngine/core/objects/AnimationComponent.ts",
    "src/GameEngine/core/objects/GameObject.ts",
    "src/GameEngine/renderer/PanelRenderComponent.ts",
    "src/GameEngine/renderer/TextRenderComponent.ts",
    "src/GameEngine/renderer/TextRenderer.ts",
    "src/GameEngine/renderer/UIImage.ts",
    "src/GameEngine/renderer/ButtonRenderComponent.ts",
    "src/GameEngine/renderer/ImageRenderComponent.ts"
  ]
}
