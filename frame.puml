@startuml

' 定义核心类和接口
class GameEngine {
    +static getInstance(): GameEngine
    +getEventDispatcher(): EventDispatcher
    +getActiveCamera(): Camera2D
    +getRenderingEngine(): RenderingEngine
    +getSceneManager(): SceneManager
    +getInputHandler(): InputHandler
    +static getScreenWidth(): number
    +static getScreenHeight(): number
}

class EntityManager {
    +createEntity(): Entity
    +getAllEntities(): Entity[]
}

class SystemManager {
    +registerSystem(system: System): void
    +update(dt: number): void
}

class Scene {
    +load(): void
    +onUnload(): void
    +addComponent(component: Component): void
    +removeComponent(component: Component): boolean
    +clearComponents(): void
    +handleKeyboardEvent(event: KeyboardEvent): void
    +handleMouseEvent(event: MouseEvent): void
    +getComponents(): Component[]
    +update(dt: number): void
    +getRenderComponents(): Component[]
}

class SceneComponent {
    +getScene(): Scene
}

class SceneManager {
    +registerScene(scene: Scene): void
    +switchScene(sceneName: string): void
}

class RenderingEngine {
    +render(): void
    +setActiveCamera(camera: Camera2D): void
}

class EventDispatcher {
    +dispatchEvent(event: any): void
}

class InputHandler {
    +handleInput(event: any): void
}

class Camera2D {
    +position: Vector2
    +scale: number
    +size: Vector2
    +name: string
    +gameObject: GameObject
}

class PhysicsSystem {
    +update(dt: number): void
}

class ScriptingSystem {
    +update(dt: number): void
}

class AnimationSystem {
    +update(dt: number): void
}

class AISystem {
    +update(dt: number): void
}

class NetworkingSystem {
    +update(dt: number): void
}

' 定义关联关系
GameEngine --> EntityManager : "1"
GameEngine --> SystemManager : "1"
GameEngine --> RenderingEngine : "1"
GameEngine --> EventDispatcher : "1"
GameEngine --> Camera2D : "1"
GameEngine --> SceneManager : "1"
GameEngine --> InputHandler : "1"

EntityManager --> Entity : "*"
SystemManager --> System : "*"

Scene --> Component : "*"
Scene --> RenderComponent : "<|.."

SceneComponent --> Scene : "1"

SceneManager --> Scene : "*"

RenderingEngine --> Camera2D : "1"

EventDispatcher --> Event : "<|.."

InputHandler --> InputEvent : "<|.."

PhysicsSystem --> Component : "<|.."
ScriptingSystem --> Component : "<|.."
AnimationSystem --> Component : "<|.."
AISystem --> Component : "<|.."
NetworkingSystem --> Component : "<|.."

@enduml