@startuml

' 核心引擎类
class GameEngine {
    +static getInstance(): GameEngine
    +getEventDispatcher(): EventDispatcher
    +getActiveCamera(): Camera2D
    +getRenderingEngine(): RenderingEngine
    +getSceneManager(): SceneManager
    +getInputHandler(): InputHandler
    +getDataManager(): DataManager
    +static getScreenWidth(): number
    +static getScreenHeight(): number
}

' 核心系统
class EntityManager {
    +createEntity(): Entity
    +getAllEntities(): Entity[]
}

class SystemManager {
    +registerSystem(system: System): void
    +update(dt: number): void
}

' 渲染系统
class RenderingEngine {
    +render(): void
    +setActiveCamera(camera: Camera2D): void
}

class CanvasManager {
    +getCtx(): CanvasRenderingContext2D
    +clear(): void
}

' 组件系统
class Component {
    +update(dt: number): void
}

class RenderComponent {
    +render(canvasManager: CanvasManager): void
}

class SceneComponent {
    +getScene(): Scene
}

' 场景管理
class Scene {
    +load(): void
    +unload(): void
    +update(dt: number): void
}

class SceneManager {
    +registerScene(scene: Scene): void
    +switchScene(sceneName: string): void
}

' 引擎子系统
class AIEngine {
    +update(dt: number): void
}

class ScriptingEngine {
    +update(dt: number): void
}

' 输入系统
class InputHandler {
    +isKeyPressed(key: string): boolean
    +isMouseButtonPressed(button: number): boolean
    +getMousePosition(): {x: number, y: number}
}

' 数据管理
class DataManager {
    +loadData(filePath: string): Promise<GameData>
    +saveData(data: any): void
}

' 相机系统
class Camera2D {
    +position: Vector2
    +scale: number
    +size: Vector2
}

' 定义关联关系
GameEngine --> EntityManager : "1"
GameEngine --> SystemManager : "1"
GameEngine --> RenderingEngine : "1"
GameEngine --> SceneManager : "1"
GameEngine --> InputHandler : "1"
GameEngine --> DataManager : "1"

EntityManager --> Entity : "*"
SystemManager --> System : "*"

SceneManager --> Scene : "*"
RenderingEngine --> CanvasManager : "1"
RenderingEngine --> Camera2D : "1"

' 组件继承关系
Component <|-- RenderComponent
Component <|-- SceneComponent

' 引擎子系统关系
GameEngine --> AIEngine : "1"
GameEngine --> ScriptingEngine : "1"

' 渲染组件实现
RenderComponent ..|> IRenderable

@enduml